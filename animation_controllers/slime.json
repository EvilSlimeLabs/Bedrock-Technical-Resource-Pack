{
  "format_version" : "1.10.0",
  "animation_controllers" : {
    "controller.animation.slime_control" : {
      "initial_state" : "default",
      "states" : {
        "default" : {
          "transitions" : [
            { "show" : "query.life_time > 0.0 ? (query.is_local_player && !query.is_in_ui && v.slime_show) : 0" }
          ]
        },
        "show" : {
          "animations": [ "slime" ],
          "transitions" : [
            { "default" : "!v.slime_show" }
          ]
        }
      }
    }
  }
}
